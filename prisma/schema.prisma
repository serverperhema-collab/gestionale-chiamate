generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  TEAM_LEADER
  OPERATORE
  COMMERCIALE
}

enum Campaign {
  PULIZIE
  PERSONALE_HEMA
  ENTRAMBI
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  username       String    @unique
  password       String // Hashed password
  role           Role      @default(OPERATORE)
  name           String
  isActive       Boolean   @default(true)
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?

  // Settings/Thresholds
  maxNoAnswer         Int @default(20)
  maxNoAnswerMins     Int @default(30)
  maxSkip             Int @default(15)
  maxSkipMins         Int @default(30)
  maxNotAvailable     Int @default(15)
  maxNotAvailableMins Int @default(30)

  noAnswerLockTime     Int @default(10)
  skipLockTime         Int @default(10)
  notAvailableLockTime Int @default(10)

  maxDeroghe      Int @default(3)
  maxDerogheHours Int @default(24)

  maxIdleTimeMins Int       @default(15)
  lastActivityAt  DateTime? @default(now())

  maxNegotiations Int     @default(10)
  canViewOutcomes Boolean @default(false)

  // Security/Anti-Fraud
  skipCount               Int       @default(0) // Legacy
  skipLockedUntil         DateTime?
  noAnswerLockedUntil     DateTime?
  notAvailableLockedUntil DateTime?
  dailyModifications      Int       @default(0)
  lastModificationDate    DateTime?
  modLockedUntil          DateTime?

  // TL Alert Preferences
  alertNoAnswerLock     Boolean @default(true)
  alertNotAvailableLock Boolean @default(true)
  alertSkipLock         Boolean @default(true)
  alertIdleLock         Boolean @default(true)
  alertDeroghe          Boolean @default(true)
  alertModLock          Boolean @default(true)

  // Modifications Configuration
  maxDailyModifications Int @default(5)
  modLockTimeMins       Int @default(10)

  // Relations
  dailyAssignments  DailyAssignment[]
  callLogs          CallLog[]
  activityLogs      ActivityLog[]
  negotiations      Negotiation[]
  asCommerciale     Appointment[]     @relation("CommercialeAppointments")
  asOperator        Appointment[]     @relation("OperatorAppointments")
  assignedContacts  Contact[]         @relation("AssignedContacts")
  zoneAgendas       ZoneAgenda[]
  quoteRequests     QuoteRequest[]
  attendances       Attendance[]      @relation("AttendanceOperator")
  attendanceUpdates Attendance[]      @relation("AttendanceUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  TlTask    TlTask[]
}

model DailyAssignment {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  date     DateTime @db.Date
  cap      String
  campaign Campaign

  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Contact {
  id String @id @default(cuid())

  // --- EXTRACTION ENGINE V2 ---
  source           ExtractionSource @default(GOOGLE)
  sourceId         String?
  rawName          String           @default("")
  rawAddress       String?
  normalizedName   String?
  normalizedStreet String?
  normalizedNumber String?
  dedupeKey        String?

  placeId        String?
  name           String
  originalPhone  String?
  hours          String?
  cap            String
  sector         String
  address        String?
  website        String?
  businessStatus String?
  url            String?

  // Enrichment
  referentName String?
  referentRole String?
  email        String?
  notes        String?

  // State
  noAnswerCount      Int       @default(0)
  hiddenUntil        DateTime?
  assignedToId       String?
  assignedTo         User?     @relation("AssignedContacts", fields: [assignedToId], references: [id])
  isKo               Boolean   @default(false)
  isPersonalCallback Boolean   @default(false)

  // Nuovi Campi per il Piano di Sviluppo
  blacklisted       Boolean   @default(false)
  blacklistReason   String?
  delegatedToId     String?
  delegatedUntil    DateTime?
  reviewRequestedAt DateTime?
  reviewNote        String?
  skipCount         Int       @default(0)
  lastOutcome       String?
  targetCompany     String?

  // Relations
  phones       ContactPhone[]
  callLogs     CallLog[]
  activityLogs ActivityLog[]
  negotiations Negotiation[]
  appointments Appointment[]
  koRecords    KoRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  TlTask    TlTask[]

  @@unique([source, sourceId])
  @@index([dedupeKey])
  @@index([name])
  @@index([cap])
  @@index([sector])
  @@index([hiddenUntil])
  @@index([assignedToId])
  @@index([isKo])
}

model ContactPhone {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  phone     String
  label     String? // e.g. "Cellulare Titolare", "Fisso"

  createdAt DateTime @default(now())
}

enum CallOutcome {
  NO_ANSWER
  NOT_AVAILABLE
  NO_INFO
  NEGOTIATION
  APPOINTMENT
  TRASH_REQUEST
  SKIP
  NON_INTERESSATO
}

model CallLog {
  id        String      @id @default(cuid())
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  outcome   CallOutcome
  notes     String?

  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  action    String // e.g. "ADDED_PHONE", "LOGIN", "SUSPENDED"
  details   String?

  createdAt DateTime @default(now())
}

model TlTask {
  id          String    @id @default(cuid())
  tlId        String
  tl          User      @relation(fields: [tlId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  title       String
  description String?
  recallDate  DateTime?
  isCompleted Boolean   @default(false)

  createdAt DateTime @default(now())
}

model Negotiation {
  id                 String  @id @default(cuid())
  contactId          String
  contact            Contact @relation(fields: [contactId], references: [id])
  operatorId         String
  operator           User    @relation(fields: [operatorId], references: [id])
  originalOperatorId String? // Per tracciare chi era il proprietario prima della delega

  recallDate  DateTime
  reason      String
  isApproved  Boolean   @default(false)
  expiresAt   DateTime?
  isExpired   Boolean   @default(false)
  isAbandoned Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApptStatus {
  PENDING
  CONFIRMED
  NOT_CONFIRMED
  DONE
  CANCELLED
  DA_GESTIRE_COMMERCIALE
}

model Appointment {
  id            String  @id @default(cuid())
  contactId     String
  contact       Contact @relation(fields: [contactId], references: [id])
  operatorId    String
  operator      User    @relation("OperatorAppointments", fields: [operatorId], references: [id])
  commercialeId String?
  commerciale   User?   @relation("CommercialeAppointments", fields: [commercialeId], references: [id])

  date        DateTime
  isPhoneAppt Boolean  @default(false)
  isDeroga    Boolean  @default(false)
  isApproved  Boolean  @default(true) // True unless isDeroga is true

  // Link all'Agenda
  zoneAgendaId String?
  zoneAgenda   ZoneAgenda? @relation(fields: [zoneAgendaId], references: [id], onDelete: SetNull)

  // Scheda
  referentName String
  referentRole String
  phone        String
  email        String?
  clientNeeds  String
  tlNotes      String?

  status           ApptStatus        @default(PENDING)
  commercialStatus CommercialStatus?
  isSecondAppt     Boolean           @default(false)

  outcomes     AppointmentOutcome[]
  quoteRequest QuoteRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommercialStatus {
  ASSEGNATO
  VISITATO
  FOLLOW_UP
  PREVENTIVO_IN_CORSO
  VENDUTO
  KO
  SALTATO_CLIENTE_DA_RIFISSARE
  SALTATO_CLIENTE_KO_RICHIESTO
  SALTATO_COMMERCIALE_DA_RIFISSARE
  SALTATO_COMMERCIALE_KO_RICHIESTO
}

enum SkipReason {
  SALTATO_CLIENTE
  SALTATO_COMMERCIALE
}

enum NextActionTarget {
  COMMERCIALE
  OPERATORE
}

enum NextActionType {
  RICHIAMO
  FISSA_NUOVO_APP
}

enum OutcomeFinal {
  VENDUTO
  NON_VENDUTO
  RIPENSARCI
  FOLLOWUP
  KO
}

enum QuoteStatus {
  PENDING
  IN_LAVORAZIONE
  REVISIONE
  COMPLETATO
  ANNULLATO
}

model AppointmentOutcome {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  outcomeFinal OutcomeFinal
  skipReason   SkipReason?
  notes        String

  nextActionType   NextActionType?
  nextActionTarget NextActionTarget?
  nextActionDate   DateTime?

  koRequested    Boolean @default(false)
  quoteAttached  Boolean @default(false)
  quoteUrl       String?
  quoteRequested Boolean @default(false)

  createdAt DateTime @default(now())
}

model QuoteRequest {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  commercialeId String
  commerciale   User        @relation(fields: [commercialeId], references: [id])

  notes  String
  status QuoteStatus @default(PENDING)

  tlNotes    String?
  quoteUrl   String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeletionRequest {
  id         String   @id @default(cuid())
  contactId  String   @unique
  operatorId String
  reason     String
  isResolved Boolean  @default(false)
  isApproved Boolean?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model KoRecord {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  frozenUntil DateTime
  isResolved  Boolean  @default(false)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model ZoneAgenda {
  id   String   @id @default(cuid())
  date DateTime // Solo la data (es. mezzanotte locale)
  name String   @default("Agenda")
  caps String[] // Array di CAP abilitati

  commercialeId String?
  commerciale   User?   @relation(fields: [commercialeId], references: [id])

  isClosed Boolean @default(false)
  tlNotes  String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CapZoneMapping {
  cap      String @id
  zoneName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AttendanceStatus {
  PRESENTE
  PARZIALE
  ASSENTE
}

enum AbsenceReason {
  MALATTIA
  FERIE
  PERMESSO
  ALTRO
}

model Attendance {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("AttendanceOperator", fields: [userId], references: [id])
  date   DateTime @db.Date

  status         AttendanceStatus
  shiftMorning   Boolean          @default(false)
  shiftAfternoon Boolean          @default(false)

  // Calcolato ESCLUSIVAMENTE dal backend:
  // Mattina=4h | Pomeriggio=3h | Entrambi=7h | Nessuno=0h
  plannedHours Float @default(0)

  // PRESENTE  → hoursWorked = plannedHours (backend lo forza, non modificabile)
  // PARZIALE  → 0 < hoursWorked < plannedHours (modificabile dal TL)
  // ASSENTE   → hoursWorked = 0 (backend lo forza)
  hoursWorked Float @default(0)

  // PRESENTE  → reason = null, customReason = null (backend li pulisce)
  // ASSENTE / PARZIALE → reason obbligatorio
  // ALTRO     → customReason obbligatorio
  reason       AbsenceReason?
  customReason String?

  // Tracciamento: chi ha fatto l'ultimo salvataggio
  updatedById String?
  updatedBy   User?   @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vincolo fondamentale: un solo record per operatore per giorno
  @@unique([userId, date])
}

enum ScrapingJobStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum QueryStatus {
  PENDING
  RUNNING
  PAGE_LIMIT_REACHED
  LOW_YIELD
  BRANCH_CLOSED
  FAILED
}

enum ExtractionSource {
  GOOGLE
  OSM
  MANUAL
}

model ScrapingJob {
  id               String            @id @default(cuid())
  cap              String
  status           ScrapingJobStatus @default(RUNNING)
  maxEstimatedCost Float
  currentCost      Float             @default(0)
  maxQueries       Int
  queriesExecuted  Int               @default(0)

  queries ScrapingQuery[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ScrapingJobEvent ScrapingJobEvent[]
}

model QueryFamily {
  id      String @id // Formato: CONCEPT__SCOPE (es. IDRAULICO__CAP_00172)
  concept String
  scope   String

  // Knowledge Base Statistics
  totalQueries           Int   @default(0)
  totalResults           Int   @default(0)
  totalNewResults        Int   @default(0)
  totalDuplicates        Int   @default(0)
  avgActualYield         Float @default(0)
  avgNewResultsPerQuery  Float @default(0)
  estimatedVsActualError Float @default(0)
  avgConfidence          Float @default(0.5)

  queries ScrapingQuery[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  QueryStrategyStat QueryStrategyStat[]
}

model ScrapingQuery {
  id       String      @id @default(cuid())
  jobId    String
  job      ScrapingJob @relation(fields: [jobId], references: [id])
  familyId String
  family   QueryFamily @relation(fields: [familyId], references: [id])

  queryText String
  strategy  String // BASE, SYNONYM, GEO_CELL, OSM_SEED

  status QueryStatus @default(PENDING)

  // Dati specifici per strategie Quadtree (GeoCell)
  geoCellId       String?
  parentGeoCellId String?
  geoDepth        Int?
  cellMinLat      Float?
  cellMaxLat      Float?
  cellMinLng      Float?
  cellMaxLng      Float?
  searchCenterLat Float?
  searchCenterLng Float?
  searchRadius    Float?

  // EXPECTED
  estimatedYield  Float?
  confidence      Float?
  gapMultiplier   Float?
  explorationMult Float?
  estimatedCost   Float?
  priority        Float?
  plannerReason   String?

  // ACTUAL
  resultCount    Int?
  newResultCount Int?
  duplicateCount Int?
  actualYield    Float?
  executionCost  Float?
  executionDurMs Int?

  lockedAt    DateTime?
  heartbeatAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([jobId, queryText])
  @@index([jobId, status])
  @@index([jobId, status, priority])
}

model QueryStrategyStat {
  id       String      @id @default(cuid())
  familyId String
  family   QueryFamily @relation(fields: [familyId], references: [id])

  strategy  String
  geoDepth  Int?
  geoCellId String?

  totalQueries    Int @default(0)
  totalResults    Int @default(0)
  totalNewResults Int @default(0)
  totalDuplicates Int @default(0)

  avgActualYield         Float @default(0)
  avgNewResultsPerQuery  Float @default(0)
  estimatedVsActualError Float @default(0)
  confidence             Float @default(0.25)

  updatedAt DateTime @updatedAt

  @@unique([familyId, strategy, geoDepth, geoCellId])
}

model ScrapingJobEvent {
  id        String      @id @default(cuid())
  jobId     String
  job       ScrapingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  timestamp DateTime    @default(now())
  type      String
  message   String
  metadata  Json?
}





